// ============================================================
// USE CASE 2: NFT / DIGITAL DEED (Ethereum: ERC-721)
// Midnight Compact equivalent of ERC-721
// Real-world: Digital Art, Land Deeds, Certificates, Event Tickets
// ============================================================
pragma language_version 0.23;

import CompactStandardLibrary;

// ------ LEDGER STATE ------
export ledger tokenCount: Counter;
export ledger nftOwner: Map<Field, Bytes<32>>;      // tokenId -> ownerPublicKey
export ledger nftMetaHash: Map<Field, Bytes<32>>;   // tokenId -> metadata IPFS hash
export ledger approvals: Map<Field, Bytes<32>>;     // tokenId -> approvedAddress

export ledger minterKey: Bytes<32>;

constructor(vk: Bytes<32>) {
  minterKey = vk;
}

// ------ WITNESSES ------
witness localSecretKey(): Bytes<32>;

// ------ HELPERS ------
export circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "nft:pk:"), sk]);
}

// ------ CIRCUITS (ERC-721 equivalents) ------

// mint() — create new unique NFT (only admin/minter)
export circuit mintNFT(to: Bytes<32>, metaHash: Bytes<32>): [] {
  assert(publicKey(localSecretKey()) == minterKey, "Only minter can mint NFTs");

  const newId = tokenCount as Field;
  tokenCount.increment(1);

  nftOwner.insert(newId, to);
  nftMetaHash.insert(newId, metaHash);
}

// transfer() — send NFT to another address
export circuit transferNFT(tokenId: Field, to: Bytes<32>): [] {
  const caller = publicKey(localSecretKey());
  // Owner OR approved address can transfer
  const isOwner = nftOwner.lookup(tokenId) == some<Bytes<32>>(caller);
  const isApproved = approvals.lookup(tokenId) == some<Bytes<32>>(caller);
  assert(isOwner || isApproved, "Not owner or approved");

  nftOwner.insert(tokenId, to);
  approvals.remove(tokenId); // Clear approval on transfer
}

// approve() — allow someone to transfer your NFT
export circuit approveNFT(tokenId: Field, spender: Bytes<32>): [] {
  const caller = publicKey(localSecretKey());
  assert(nftOwner.lookup(tokenId) == some<Bytes<32>>(caller), "Not the owner");
  approvals.insert(tokenId, spender);
}

// burn() — destroy the NFT permanently
export circuit burnNFT(tokenId: Field): [] {
  const caller = publicKey(localSecretKey());
  assert(nftOwner.lookup(tokenId) == some<Bytes<32>>(caller), "Not the owner");
  nftOwner.remove(tokenId);
  nftMetaHash.remove(tokenId);
  approvals.remove(tokenId);
}
