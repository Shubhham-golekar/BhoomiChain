{
  "name": "@midnight-ntwrk/bboard-cli",
  "version": "0.1.0",
  "author": "IOG",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -R ../contract/src/managed dist/contract/src/managed",
    "ci": "npm run typecheck && npm run lint && npm run build",
    "lint": "eslint src",
    "prepack": "npm run build",
    "standalone": "node --import tsx/esm src/launcher/standalone.ts",
    "preview-remote": "node --import tsx/esm src/launcher/preview.ts",
    "preprod-remote": "node --import tsx/esm src/launcher/preprod.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-protocol": "^4.1.1",
    "@midnight-ntwrk/testkit-js": "^4.1.1",
    "@midnight-ntwrk/wallet-sdk-facade": "^4.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.3"
  }
}
