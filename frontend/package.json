{
  "name": "@midnight-ntwrk/bboard-ui",
  "version": "0.1.0",
  "author": "IOG",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build --mode preprod",
    "build:preview": "tsc && vite build --mode preview",
    "build:vercel": "tsc --noEmit && vite build --mode preview",
    "build:start": "npm run build && npm run start",
    "build:start:preview": "npm run build:preview && npm run start",
    "ci": "npm run typecheck && npm run lint",
    "dev": "vite",
    "lint": "eslint ./src",
    "start": "http-server --port 0 ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "node-stdlib-browser": "^1.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@swc/core": "^1.15.41",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "eslint-plugin-react": "^7.37.5",
    "rollup": "^4.62.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}